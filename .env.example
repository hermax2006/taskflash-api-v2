APP_NAME=TaskFlash
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api.koyeb.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Supabase / PostgreSQL ---
# Utilise le Session pooler (port 5432, compatible IPv4).
# Recupere la chaine exacte dans Supabase > Connect > Session pooler.
DB_CONNECTION=pgsql
# Alternative a DB_HOST/DB_PORT/... : DB_URL (encoder les caracteres speciaux du mot de passe)
# DB_URL=postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres
DB_HOST=[POOLER-HOST]
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.[PROJECT-REF]
DB_PASSWORD=
DB_SSLMODE=require
# Optionnel : schema dedie pour ne pas exposer les tables via l'API Supabase
DB_SEARCH_PATH=public

FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Laravel Reverb ---
# Genere un secret unique : openssl rand -hex 20
REVERB_APP_ID=935424
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# En mode un seul service Koyeb, Laravel envoie les events a Reverb en local.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

# Cote navigateur (build du frontend) : utilise le domaine public Koyeb et wss:443.
# VITE_REVERB_APP_KEY=<meme valeur que REVERB_APP_KEY>
# VITE_REVERB_HOST=your-api.koyeb.app
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
